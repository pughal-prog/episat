# EpiSat 2.0 Environment Configuration

PROJECT_NAME="EpiSat 2.0 — Space-to-Action AI Platform"
API_V1_STR="/api/v1"
SECRET_KEY="episat-production-secret-key-space-to-action-2026-super-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / PostGIS for production, SQLite for local dev)
DATABASE_URL="postgresql+asyncpg://episat:episat_password@localhost:5432/episat_db"
# DATABASE_URL="sqlite+aiosqlite:///backend/episat.db"

# Data Provider Mode (demo / real)
DATA_MODE="demo"
DEMO_MODE=true

# Satellite & Weather API Credentials
SATELLITE_API_KEY=""
WEATHER_API_KEY=""
GEE_PROJECT_ID=""

# Google Earth Engine Service Account Credentials
GEE_SERVICE_ACCOUNT_EMAIL=""
GEE_SERVICE_ACCOUNT_KEY_PATH=""
GEE_GCP_PROJECT_ID=""

# NASA Earthdata Credentials (MODIS NRT LANCE & GPM IMERG)
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""

# Redis Cache & Task Broker URL
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://127.0.0.1:3000","http://127.0.0.1:5000"]
